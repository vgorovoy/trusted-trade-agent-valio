# Valio Aimo mock API (key is on the Junction challenge page; never commit the real value)
VALIO_BASE_URL=https://junction26.valioaimo.fi
VALIO_API_KEY=
VALIO_CUSTOMER=junction-demo
# Mandates, offers, receipts and passports are signed with Ed25519 keys kept in data/keys and
# data/buyers (gitignored). Demo wallet endpoint for the UI (signs cart confirmations):
# TTA_DEMO_WALLET=1
# TTA_OFFER_TTL_MIN=60
# TTA_APPROVAL_HOLD_H=24
# Gateway state (orders, offers, audit) in Postgres instead of data/state.sqlite: Aiven
# connection string (TTA_STORE_URL wins if both are set). Placeholders only, never real values.
# AIVEN_PG_URL=postgres://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require
# TTA_STORE_URL=

# Explicit isolated demo runtime (no automatic database fallback):
# TTA_LOCAL=1
# TTA_DEMO_CLOCK=2026-11-12T10:00:00+02:00
